@model SignInViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@if (TempData["Message"] != null)
{
	<div id="alert-message" class="alert alert-success">
		@TempData["Message"]
	</div>
}
<div asp-validation-summary="ModelOnly"></div>
<form asp-action="SignIn">

	<div class="form-group">
		<input asp-for="EmailOrUsername" class="form-control text" placeholder="Email or Username" required="">
		<span asp-validation-for="EmailOrUsername" class="text-danger"></span>
	</div>


	<div class="form-group">
		<input asp-for="password" class="form-control text " placeholder="Password" required="">
		<span asp-validation-for="password"></span>
	</div>



	<div class="wthree-text">
		<label class="anim">
			<input asp-for="RememberMe" type="checkbox" class="form-check-input checkbox">
			<span>&nbsp;  Remember Me</span>
		</label>
		<div class="clear"> </div>
		<span asp-validation-for="RememberMe" class="text-danger"></span>
	</div>


	<input type="submit" value="SIGNUP">
</form>
<p>Don`t have an Account? <a asp-action="SignUp"> SignUp Now!</a></p>
<p>Forget Password ? <a asp-action="ResetPassword"> ResetIt Now!</a></p>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		setTimeout(function () {
			var alert = document.getElementById("alert-message");
			if (alert) {
				alert.style.display = "none";
			}
		}, 3000); // 3 ثواني
	</script>
}

