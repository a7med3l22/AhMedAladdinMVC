<div class="form-group">
    <label asp-for="PhoneNumber" class="col-form-label"></label>
    <input asp-for="PhoneNumber" class="form-control" />
    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Email" class="col-form-label"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Department" class="col-form-label"></label>
    <select asp-for="DepartmentId" asp-items="SelectListdepartments" class="form-control">
        <option value="@null" selected >(Default) In No Department</option>
    </select>
    <span asp-validation-for="DepartmentId" class="text-danger"></span>
</div>


<br />
@* imageName علشان يبعت معايا ال *@
<input type="hidden" asp-for="ImageName" />
    <div class="form-group">
        <label asp-for="Image" class="col-form-label">Upload Image: </label>
        <input asp-for="Image" class="form-control-file" />
    <br />

    </div>



<br />
<div class="form-group form-check">
    <label asp-for="IsActive" class="form-check-label">Is Active</label>
    <input asp-for="IsActive" class="form-check-input" />
    <span asp-validation-for="IsActive" class="text-danger"></span>
</div>
