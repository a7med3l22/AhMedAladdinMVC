<div class="form-group">
    <label asp-for="PhoneNumber" class="col-form-label"></label>
    <input asp-for="PhoneNumber" class="form-control" disabled />
</div>

<div class="form-group">
    <label asp-for="Email" class="col-form-label"></label>
    <input asp-for="Email" class="form-control" disabled />
</div>


<div class="form-group">
    <label asp-for="Department" class="col-form-label"></label>
    <select  disabled asp-for="DepartmentId" asp-items="departments" class="form-control"> 
        <option>(Default) In No Department</option>
    </select>
</div>


