
@{
    ViewData["Title"] = "Delete Employee";

    var genders = ViewBag.Genders;
    var empTypes = ViewBag.EmpTypes;
}
@model Employee

<h1>
    Are You Sure To Delete This Employee ?
</h1>

<br />
<br />



<form asp-action="Delete">
    <div class="form-group">
        <label asp-for="Name" class="col-form-label"></label>
        <input asp-for="Name" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Age" class="col-form-label"></label>
        <input asp-for="Age" class="form-control" readonly />

    </div>

    <div class="form-group">
        <label asp-for="Address" class="col-form-label"></label>
        <input asp-for="Address" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Salary" class="col-form-label"></label>
        <input asp-for="Salary" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="HiringDate" class="col-form-label"></label>
        <input asp-for="HiringDate" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Gender" class="col-form-label"></label>
        <select disabled asp-for="Gender" asp-items="genders" class="form-control">
        </select>
    </div>

    <div class="form-group">
        <label asp-for="EmpType" class="col-form-label"></label>
        <select disabled asp-for="EmpType" asp-items="empTypes" class="form-control">
        </select>
    </div>



    @* <div class="form-group"> *@
    @*     <label asp-for="CreationDate" class="col-form-label"></label> *@
    @*     <input asp-for="CreationDate" class="form-control" /> *@
    @*     <span asp-validation-for="CreationDate" class="text-danger"></span> *@
    @* </div> *@


    <div class="form-group form-check">
        <label asp-for="IsDeleted" class="form-check-label">Is Deleted</label>
        <input asp-for="IsDeleted" class="form-check-input" disabled />
    </div>


    <div class="form-group">
        <label asp-for="PhoneNumber" class="col-form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Email" class="col-form-label"></label>
        <input asp-for="Email" class="form-control" readonly />
    </div>

    <div class="form-group form-check">
        <label asp-for="IsActive" class="form-check-label">Is Active</label>
        <input asp-for="IsActive" class="form-check-input" disabled />
    </div>

    <br />
    <input type="submit" value="Yes" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>