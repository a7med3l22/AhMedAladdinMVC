@model IEnumerable<Employee>
@{
    ViewData["Title"] = "All Emoloyee";
    var culture = new System.Globalization.CultureInfo("ar-EG");
    culture.NumberFormat.CurrencyDecimalDigits = 0; 
}
<h1>All Emoloyee</h1>
<br />
<br />
    <a asp-action="Create"  class="btn btn-primary">
        Create New Employee
    </a>

<br />
<br />
@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(E=>E.Name)</th>
                <th>@Html.DisplayNameFor(E => E.Age)</th>
                <th>@Html.DisplayNameFor(E => E.Salary)</th>
                <th>@Html.DisplayNameFor(E => E.Gender)</th>
                <th>@Html.DisplayNameFor(E => E.Email)</th>
                <th>@Html.DisplayNameFor(E => E.IsActive)</th>
                <th>@Html.DisplayNameFor(E => E.Department)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>   
        </thead>

        <tbody>
            
                @foreach (var emp in Model)
                {
                    //  استخدم @Html.DisplayFor لما يكون في تنسيق مخصص أو بيانات حساسة للتنسيق (تاريخ، عملة، رقم هاتف، بريد).
                <tr>
                    <td>@emp.Name</td> 
                    <td>@emp.Age</td> 
                    @* <td>@emp.Address</td> *@
                    <td> @emp.Salary.ToString("C", culture)</td>
                    @* <td>@Html.DisplayFor(model => emp.HiringDate)</td> *@
                    <td>@Html.DisplayFor(model =>emp.Gender)</td>  
                    @* <td>@Html.DisplayFor(model =>emp.EmpType)</td> *@
                    @* <td>@Html.DisplayFor(model =>emp.CreationDate)</td> *@
                    @* <td>@Html.DisplayFor(model =>emp.IsDeleted)</td> *@
                    @* <td>@Html.DisplayFor(model =>emp.PhoneNumber)</td> *@
                    <td>@Html.DisplayFor(model =>emp.Email)</td>
                    <td>@Html.DisplayFor(model => emp.IsActive)</td>
                    <td>@emp.Department?.Name</td>
                    <partial name="_sharedbuttonsPartial" model="@emp.Id" />
                </tr>
                }
            
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        <h4>No Employees Found!</h4>
    </div>
}


